<section class="w-full bg-[#0A0E1A] py-16 lg:py-24 relative overflow-hidden border-b border-cyan-500/20">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-cyan-500/30 text-cyan-300 font-mono text-xs tracking-widest uppercase">
        <span>ARCHITECTURAL BENCHMARKS</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white font-sans">
        ENGINEERED FOR <span class="bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">MAXIMUM VELOCITY</span>
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Every millimeter is calibrated for extreme computational throughput, cryogenic thermal dissipation, and zero-compromise reliability.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      
      <!-- Bento Card 1: Neural Core (8 Cols) -->
      <div class="lg:col-span-8 rounded-2xl bg-[#0F172A]/70 backdrop-blur-xl border border-slate-800 p-8 sm:p-10 relative overflow-hidden group hover:border-cyan-500/50 transition-all duration-500 hover:shadow-[0_0_40px_rgba(0,240,255,0.15)] flex flex-col justify-between min-h-[380px]">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/25 transition-colors duration-500"></div>
        
        <!-- Header & Pill -->
        <div class="space-y-4 max-w-lg z-10">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 font-mono text-xs uppercase tracking-wider">
              CORE PROTOCOL
            </span>
            <span class="text-xs font-mono text-slate-500">// 128 TFLOPs</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Next-Gen Neural Co-Processor
          </h3>
          <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
            Direct on-die hardware acceleration capable of processing real-time telemetry, spatial sound rendering, and predictive latency compensation.
          </p>
        </div>

        <!-- Metric Bars -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-8 z-10 border-t border-slate-800/80 mt-6">
          <div>
            <div class="text-slate-500 text-xs font-mono uppercase">Compute Pipeline</div>
            <div class="text-xl font-bold font-mono text-cyan-400 mt-1">128-Bit V4</div>
          </div>
          <div>
            <div class="text-slate-500 text-xs font-mono uppercase">Power Draw</div>
            <div class="text-xl font-bold font-mono text-emerald-400 mt-1">4.2W Ultra-Low</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-slate-500 text-xs font-mono uppercase">Thermal Index</div>
            <div class="text-xl font-bold font-mono text-purple-400 mt-1">Sub-35°C</div>
          </div>
        </div>
      </div>

      <!-- Bento Card 2: Titanium Unibody (4 Cols) -->
      <div class="lg:col-span-4 rounded-2xl bg-[#0F172A]/70 backdrop-blur-xl border border-slate-800 p-8 relative overflow-hidden group hover:border-purple-500/50 transition-all duration-500 hover:shadow-[0_0_40px_rgba(139,92,246,0.15)] flex flex-col justify-between min-h-[380px]">
        <div class="absolute -right-10 -top-10 w-60 h-60 bg-purple-500/15 rounded-full blur-3xl pointer-events-none group-hover:bg-purple-500/25 transition-colors duration-500"></div>

        <div class="space-y-4 z-10">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded bg-purple-950/80 border border-purple-500/40 text-purple-300 font-mono text-xs uppercase tracking-wider">
              CHASSIS
            </span>
          </div>
          <h3 class="text-2xl font-bold text-white tracking-tight">
            Grade 5 Titanium
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            CNC-machined from single-billet aerospace titanium alloy. Lightweight, non-magnetic, and scratch-resistant carbon armor.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-800/80 z-10">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">Tensile Strength</span>
            <span class="text-purple-400 font-bold">950 MPa</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mt-2">
            <div class="bg-gradient-to-r from-purple-500 to-cyan-400 h-full w-[88%]"></div>
          </div>
        </div>
      </div>

      <!-- Bento Card 3: Cryptographic Vault (4 Cols) -->
      <div class="lg:col-span-4 rounded-2xl bg-[#0F172A]/70 backdrop-blur-xl border border-slate-800 p-8 relative overflow-hidden group hover:border-sky-500/50 transition-all duration-500 hover:shadow-[0_0_40px_rgba(56,189,248,0.15)] flex flex-col justify-between min-h-[340px]">
        <div class="space-y-4 z-10">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded bg-sky-950/80 border border-sky-500/40 text-sky-300 font-mono text-xs uppercase tracking-wider">
              SECURITY
            </span>
          </div>
          <h3 class="text-2xl font-bold text-white tracking-tight">
            Hardware Enclave
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Isolated cryptographic coprocessor with biometric key derivation and tamper-resistant silicon fuses.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-800/80 z-10 flex items-center gap-3">
          <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"></div>
          <span class="text-xs font-mono text-slate-300">FIPS 140-3 LEVEL 4 CERTIFIED</span>
        </div>
      </div>

      <!-- Bento Card 4: Quantum Charging & Endurance (8 Cols) -->
      <div class="lg:col-span-8 rounded-2xl bg-[#0F172A]/70 backdrop-blur-xl border border-slate-800 p-8 sm:p-10 relative overflow-hidden group hover:border-emerald-500/50 transition-all duration-500 hover:shadow-[0_0_40px_rgba(52,211,153,0.15)] flex flex-col justify-between min-h-[340px]">
        <div class="absolute -left-10 -bottom-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="space-y-4 max-w-lg z-10">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 font-mono text-xs uppercase tracking-wider">
              ENERGY ARCHITECTURE
            </span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Solid-State GaN Supercharge
          </h3>
          <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
            Charge from 0% to 80% in just 18 minutes with adaptive GaN pulsed current algorithms that preserve 95% battery capacity after 2,000 cycles.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 pt-6 border-t border-slate-800/80 z-10 mt-6">
          <div>
            <div class="text-xs font-mono text-slate-500">Fast Charge 80%</div>
            <div class="text-xl font-bold font-mono text-emerald-400 mt-1">18 Mins</div>
          </div>
          <div>
            <div class="text-xs font-mono text-slate-500">Endurance Run</div>
            <div class="text-xl font-bold font-mono text-cyan-400 mt-1">48+ Hours</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-xs font-mono text-slate-500">Lifespan Rating</div>
            <div class="text-xl font-bold font-mono text-purple-400 mt-1">2,000 Cycles</div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Tech Bento Grid",
  "tag": "section",
  "class": "section-tech-bento-grid",
  "settings": [],
  "presets": [
    {
      "name": "Tech Bento Grid"
    }
  ]
}
{% endschema %}
