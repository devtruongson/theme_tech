<div class="w-full bg-[#070A14] text-cyan-400 border-b border-cyan-500/25 py-2 font-mono text-xs tracking-wider select-none relative overflow-hidden z-20">
  <div class="tech-container flex items-center justify-between gap-4">
    <!-- Left telemetry status -->
    <div class="hidden sm:flex items-center gap-2 text-slate-400">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400 shadow-[0_0_8px_#00F0FF]"></span>
      </span>
      <span class="text-cyan-300 font-semibold">[SYS: ONLINE]</span>
      <span class="text-slate-600">//</span>
      <span class="text-slate-400 hidden md:inline">QUANTUM NODE 01</span>
    </div>

    <!-- Center Announcement message -->
    <div class="flex-1 text-center truncate">
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}
          <div class="inline-flex items-center gap-2 justify-center" {{ block.shopify_attributes }}>
            <span class="text-pink-400 font-bold">⚡ ALERT:</span>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="text-cyan-300 hover:text-white transition-colors duration-200 underline decoration-cyan-500/50 hover:decoration-cyan-400">
                {{ block.settings.text | default: "GLOBAL EXPEDITED DISPATCH ENABLED // ORDERS OVER $150 SHIP FREE" }}
              </a>
            {%- else -%}
              <span class="text-slate-200">
                {{ block.settings.text | default: "GLOBAL EXPEDITED DISPATCH ENABLED // ORDERS OVER $150 SHIP FREE" }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="inline-flex items-center gap-2 justify-center">
          <span class="text-pink-400 font-bold">⚡ NEXUS 2026:</span>
          <span class="text-slate-200">QUANTUM HARDWARE PROTOCOL ACTIVE // WORLDWIDE FREE DISPATCH</span>
        </div>
      {%- endfor -%}
    </div>

    <!-- Right HUD stats -->
    <div class="hidden lg:flex items-center gap-3 text-slate-400">
      <span class="text-slate-500">LATENCY:</span>
      <span class="text-cyan-400 font-bold">0.12ms</span>
      <span class="text-slate-600">//</span>
      <span class="text-emerald-400">ENCRYPTION: 4096-BIT</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "GLOBAL EXPEDITED DISPATCH ENABLED // ORDERS OVER $150 SHIP FREE",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
