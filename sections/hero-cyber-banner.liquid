<section class="relative w-full overflow-hidden bg-[#0A0E1A] py-12 lg:py-24 border-b border-cyan-500/20">
  <!-- Cybernetic Grid & Ambient Lighting -->
  <div class="absolute inset-0 pointer-events-none opacity-40" style="background-image: linear-gradient(to right, rgba(0, 240, 255, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px); background-size: 40px 40px;"></div>
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute top-1/2 -right-40 w-96 h-96 bg-purple-600/20 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 text-left">
        
        <!-- Tech Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#111827] border border-cyan-500/40 text-cyan-300 font-mono text-xs uppercase tracking-wider shadow-[0_0_15px_rgba(0,240,255,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </span>
          <span>{{ section.settings.badge_text | default: "SYSTEM STATUS: RE-ENGINEERED // 2026 EDITION" }}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-white leading-[1.05]">
          {{ section.settings.heading_pre | default: "THE NEXT ERA OF" }}
          <span class="block bg-gradient-to-r from-cyan-400 via-sky-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(0,240,255,0.4)]">
            {{ section.settings.heading_highlight | default: "QUANTUM HARDWARE" }}
          </span>
        </h1>

        <!-- Subheading -->
        <p class="text-slate-300 text-base sm:text-lg max-w-xl leading-relaxed font-sans font-normal">
          {{ section.settings.subheading | default: "High-performance neural computing devices, cybernetic wearables, and decentralized hardware engineered with zero-compromise precision." }}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a href="{{ section.settings.button_primary_link | default: routes.all_products_collection_url }}" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded bg-cyan-400 text-slate-950 font-bold font-mono uppercase text-sm tracking-wider transition-all duration-300 hover:bg-cyan-300 hover:shadow-[0_0_30px_rgba(0,240,255,0.6)] hover:-translate-y-0.5 active:translate-y-0">
            <span>{{ section.settings.button_primary_label | default: "ACQUIRE HARDWARE" }}</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a href="{{ section.settings.button_secondary_link | default: '#specs-matrix' }}" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded bg-[#111827]/80 text-cyan-400 font-mono uppercase text-sm tracking-wider border border-cyan-500/40 hover:border-cyan-400 hover:bg-cyan-950/40 hover:shadow-[0_0_20px_rgba(0,240,255,0.25)] transition-all duration-300">
            <span>{{ section.settings.button_secondary_label | default: "EXPLORE TELEMETRY" }}</span>
          </a>
        </div>

        <!-- HUD Telemetry Metrics Grid -->
        <div class="w-full pt-8 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="p-3 rounded bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-bold font-mono text-cyan-400">0.12<span class="text-xs text-slate-400">ms</span></div>
            <div class="text-[11px] font-mono uppercase text-slate-400 tracking-wider">Zero Latency</div>
          </div>
          <div class="p-3 rounded bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-bold font-mono text-purple-400">128<span class="text-xs text-slate-400">Core</span></div>
            <div class="text-[11px] font-mono uppercase text-slate-400 tracking-wider">Neural NPU</div>
          </div>
          <div class="p-3 rounded bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-bold font-mono text-sky-400">4096<span class="text-xs text-slate-400">Bit</span></div>
            <div class="text-[11px] font-mono uppercase text-slate-400 tracking-wider">Enclave Cipher</div>
          </div>
          <div class="p-3 rounded bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-bold font-mono text-emerald-400">100<span class="text-xs text-slate-400">W</span></div>
            <div class="text-[11px] font-mono uppercase text-slate-400 tracking-wider">GaN Charge</div>
          </div>
        </div>

      </div>

      <!-- Right Visual Column (Hardware Device & Hologram Telemetry) -->
      <div class="lg:col-span-5 relative flex justify-center items-center">
        <!-- Glowing Backdrop Halo -->
        <div class="absolute w-72 sm:w-96 h-72 sm:h-96 rounded-full bg-gradient-to-tr from-cyan-500/25 to-purple-600/25 blur-3xl -z-10 animate-pulse"></div>

        <div class="relative w-full max-w-lg group">
          <!-- Glassmorphic Hardware Card Wrapper -->
          <div class="relative rounded-2xl overflow-hidden border border-cyan-500/30 bg-[#0F172A]/70 backdrop-blur-xl p-2 shadow-[0_0_50px_rgba(0,0,0,0.8),0_0_30px_rgba(0,240,255,0.15)] transition-all duration-500 group-hover:border-cyan-400/60 group-hover:shadow-[0_0_60px_rgba(0,240,255,0.3)]">
            
            {%- if section.settings.hero_image != blank -%}
              {{ section.settings.hero_image | image_url: width: 1000 | image_tag: class: 'w-full h-auto rounded-xl object-cover transition-transform duration-700 group-hover:scale-105' }}
            {%- else -%}
              <img src="{{ 'hero-cyber-hardware.jpg' | asset_url }}" alt="Cyber Hardware Unit" class="w-full h-auto rounded-xl object-cover transition-transform duration-700 group-hover:scale-105">
            {%- endif -%}

            <!-- Corner Tech Accents -->
            <div class="absolute top-4 left-4 w-3 h-3 border-t-2 border-l-2 border-cyan-400"></div>
            <div class="absolute top-4 right-4 w-3 h-3 border-t-2 border-r-2 border-cyan-400"></div>
            <div class="absolute bottom-4 left-4 w-3 h-3 border-b-2 border-l-2 border-cyan-400"></div>
            <div class="absolute bottom-4 right-4 w-3 h-3 border-b-2 border-r-2 border-cyan-400"></div>
          </div>

          <!-- Floating Telemetry Chip 1 (Top Right) -->
          <div class="absolute -top-4 -right-2 sm:-right-4 px-3 py-2 rounded-lg bg-[#070A14]/90 backdrop-blur-md border border-cyan-500/40 text-cyan-300 font-mono text-[11px] shadow-[0_0_15px_rgba(0,240,255,0.25)] flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            <span>NEURAL LINK // ACTIVE</span>
          </div>

          <!-- Floating Telemetry Chip 2 (Bottom Left) -->
          <div class="absolute -bottom-4 -left-2 sm:-left-4 px-3.5 py-2 rounded-lg bg-[#070A14]/90 backdrop-blur-md border border-purple-500/40 text-purple-300 font-mono text-[11px] shadow-[0_0_15px_rgba(139,92,246,0.25)] flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path>
            </svg>
            <span>CORE CLOCK: 4.8 GHz</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Cyber Banner",
  "tag": "section",
  "class": "section-hero-cyber",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "SYSTEM STATUS: RE-ENGINEERED // 2026 EDITION"
    },
    {
      "type": "text",
      "id": "heading_pre",
      "label": "Heading Prefix",
      "default": "THE NEXT ERA OF"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight",
      "default": "QUANTUM HARDWARE"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "High-performance neural computing devices, cybernetic wearables, and decentralized hardware engineered with zero-compromise precision."
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary Button Label",
      "default": "ACQUIRE HARDWARE"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary Button Label",
      "default": "EXPLORE TELEMETRY"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Cyber Banner"
    }
  ]
}
{% endschema %}
